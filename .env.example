# Copy to apps/web/.env for local development. Never commit real values.

# Runtime connection. Local: the docker-compose database below.
# Neon: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://splitlah:splitlah@localhost:5432/splitlah"

# Migrations only. Neon: the DIRECT (non-pooled) connection string.
# Local: same as DATABASE_URL.
DIRECT_URL="postgresql://splitlah:splitlah@localhost:5432/splitlah"
