# Copy to apps/web/.env for local development. Never commit real values.

# Runtime connection. Local: the docker-compose database below.
# Neon: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://kiralah:kiralah@localhost:5432/kiralah"

# Migrations only. Neon: the DIRECT (non-pooled) connection string.
# Local: same as DATABASE_URL.
DIRECT_URL="postgresql://kiralah:kiralah@localhost:5432/kiralah"

# Any long random string. Scrambles the hashed IPs used for rate limiting.
RATE_LIMIT_SALT="change-me"

# Bills one device can create per hour.
BILL_CREATE_HOURLY_LIMIT="30"

# Receipt reading with Claude. Without a key, receipt scanning is switched off
# and payers type their dishes instead.
ANTHROPIC_API_KEY=""

# Receipt scans one device can make per hour, and in total per day for everyone.
RECEIPT_HOURLY_LIMIT="10"
RECEIPT_DAILY_CAP="200"

# Any long random string. Vercel Cron sends it to the daily cleanup that deletes bills after 30 days.
CRON_SECRET="change-me"
