generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Skeleton only: Phase 2 adds items, people and payment details.
model Bill {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
