generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bill {
  id              String   @id
  /// SHA-256 of the payer's edit token. The token itself is only on their device.
  editTokenHash   String
  /// Goes up on every change, so phones can ask "anything new?" cheaply.
  version         Int      @default(0)
  locale          String
  restaurantName  String?
  mode            String
  payerId         String
  cashRounding    Boolean
  /// Itemised bills only. Validated with Zod on every read.
  charges         Json?
  discounts       Json?
  adjustments     Json?
  receiptTotalSen Int?
  /// Equal-split bills only.
  equalTotalSen   Int?
  paymentBankName String?
  paymentAccount  String?
  paymentPhone    String?
  paymentQr       Bytes?
  paymentQrType   String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  people Person[]
  items  Item[]

  @@index([expiresAt])
}

model Person {
  billId      String
  id          String
  name        String
  position    Int
  /// A "Friend 2" slot in an equal split, waiting for someone to take it.
  placeholder Boolean   @default(false)
  /// SHA-256 of the token on the phone that picked this name. Null until someone does.
  tokenHash   String?
  paidAt      DateTime?
  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  claims      Claim[]

  @@id([billId, id])
}

model Item {
  billId       String
  id           String
  name         String
  quantity     Int
  unitPriceSen Int
  position     Int
  bill         Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  claims       Claim[]

  @@id([billId, id])
}

/// One row per person who had an item. Separate rows, so friends tapping at once never collide.
model Claim {
  billId   String
  itemId   String
  personId String
  portions Int    @default(1)
  item     Item   @relation(fields: [billId, itemId], references: [billId, id], onDelete: Cascade)
  person   Person @relation(fields: [billId, personId], references: [billId, id], onDelete: Cascade)

  @@id([billId, itemId, personId])
}

/// Counts requests per hashed IP per hour. Holds no IP addresses.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
