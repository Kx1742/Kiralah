    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@splitlah/core": "workspace:*",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
